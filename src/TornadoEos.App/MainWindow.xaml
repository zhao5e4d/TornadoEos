<Window x:Class="TornadoEos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TornadoEos.App.ViewModels"
        Title="Tornado EOS — Menu Language Utility"
        Height="780" Width="1040"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,18">
            <StackPanel>
                <TextBlock Text="TORNADO EOS" Foreground="{StaticResource TextBrush}"
                           FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Canon EOS service utility · Menu language" 
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#FF22272E" CornerRadius="14" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF5A6472" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#FF3FB950" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Camera / connection card -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CAMERA" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CameraModel}" Style="{StaticResource FieldValue}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial No." Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource FieldValue}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Firmware" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareVersion}" Style="{StaticResource FieldValue}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Battery" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BatteryText}" Style="{StaticResource FieldValue}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Port" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PortDescription}" Style="{StaticResource FieldValue}" />
                    </Grid>

                    <Separator Margin="0,12" Background="{StaticResource PanelBorderBrush}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectCommand}" Width="150" Margin="0,0,10,0" />
                        <Button Content="Disconnect" Style="{StaticResource GhostButton}"
                                Command="{Binding DisconnectCommand}" Width="150" />
                    </StackPanel>

                    <Button Content="Run diagnostics" Style="{StaticResource GhostButton}"
                            Command="{Binding RunDiagnosticsCommand}"
                            HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            ToolTip="Read-only WPD, MTP, and EOS property scan (does not modify the camera)" />
                </StackPanel>
            </Border>

            <!-- Language card -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="MENU LANGUAGE" Style="{StaticResource SectionTitle}" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current on camera" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding CurrentLanguageText}" Style="{StaticResource FieldValue}"
                                       FontSize="15" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Regional language lock" Style="{StaticResource FieldLabel}" />
                            <TextBlock Margin="0,2,0,0" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldValue}">
                                        <Setter Property="Text" Value="Disabled (all languages)" />
                                        <Setter Property="Foreground" Value="#FF3FB950" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LanguageLockEnabled}" Value="True">
                                                <Setter Property="Text" Value="Enabled (EN / JA only)" />
                                                <Setter Property="Foreground" Value="#FFE3B341" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,14" Background="{StaticResource PanelBorderBrush}" />

                    <TextBlock Text="Set menu language to" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              IsEnabled="{Binding IsConnected}"
                              Height="34" FontSize="13" Padding="8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EnglishName}" FontWeight="Medium" Width="170" />
                                    <TextBlock Text="{Binding NativeName}" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Content="Automatically disable the language lock if the chosen language is hidden"
                              IsChecked="{Binding AutoUnlock}"
                              Foreground="{StaticResource MutedBrush}" Margin="2,14,0,0" />

                    <Button Content="Apply to camera" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyLanguageCommand}"
                            HorizontalAlignment="Left" Width="190" Margin="0,16,0,0" />

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" Background="#FF2A303A"
                                     BorderThickness="0" />
                        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log / diagnostics -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,0">
            <TabControl>
                <TabItem Header="Activity log">
                    <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,8,0,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <TabItem Header="Diagnostics">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Run diagnostics" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RunDiagnosticsCommand}" Width="150" Margin="0,0,10,0" />
                            <Button Content="Copy report" Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyDiagnosticsCommand}" Width="120" Margin="0,0,10,0" />
                            <Button Content="Save as…" Style="{StaticResource GhostButton}"
                                    Command="{Binding SaveDiagnosticsCommand}" Width="110" Margin="0,0,10,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Text="{Binding DiagnosticsSummary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border DockPanel.Dock="Top" Background="#FF12151A" CornerRadius="6"
                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                                Padding="2" Margin="0,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding DiagnosticsReport, Mode=OneWay}"
                                         IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                         TextWrapping="NoWrap" AcceptsReturn="True"
                                         Padding="10,8" MinHeight="180" />
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
